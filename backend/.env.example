# Copier ce fichier en ".env" pour le développement local (le .env n'est jamais commité).
# En production (Render), définir ces variables dans "Environment" du service.

# Port d'écoute (Render le définit automatiquement)
PORT=3000

# URL de connexion PostgreSQL (Supabase > Project Settings > Database > Connection string).
# Si vide : l'API stocke les tickets EN MÉMOIRE (pratique pour tester, mais non persistant).
DATABASE_URL=

# Mettre "false" uniquement pour une base PostgreSQL locale sans SSL (Supabase exige SSL).
DATABASE_SSL=true

# URL(s) du frontend autorisée(s) à appeler l'API, séparées par des virgules.
# Ex. en production : https://mon-projet.vercel.app
CORS_ORIGIN=http://localhost:5173
